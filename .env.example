# Copy to .env and adjust. All variables are optional; defaults are safe for local use.

# Confidence below which an assessment is routed to manual review instead of being
# reported as a firm classification. The model is fallible, so a weak call is flagged.
SV_MIN_CONFIDENCE=0.55

# Rule layer: robust-z contrast of the brightest blob above which the image is called
# a hotspot outright (an unambiguous, bright, localised blob needs no model).
SV_HOTSPOT_CONTRAST_Z=6.0

# Rule layer: dark-area fraction above which a compact, blocky dark region is called a
# dead cell outright (a whole inactive cell reads as a large solid dark block).
SV_DEAD_CELL_DARK_FRAC=0.020

# Rule layer: elongation of the largest dark region above which a thin, isolated dark
# streak is called a crack outright (a micro-crack is long and narrow, unlike a block).
SV_CRACK_MIN_ELONGATION=4.0
